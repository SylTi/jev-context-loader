      "content": [
        {
          "type": "reasoning",
          "text": "The user wants to search GitHub issues in the repo owner/example for those that talk about a connection error. Let me search for relevant tools first.\n\nI should use fixture_search to find tools related to searching GitHub issues.",
          "state": {
            "reasoningField": "reasoning_content"
          },
