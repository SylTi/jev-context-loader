            "completed": 1791309133657
          }
        },
        {
          "type": "tool",
          "id": "call_a7af5c083fd84efba87df48c",
          "name": "fixture_search",
          "executed": false,
          "state": {
            "status": "completed",
            "input": {
              "query": "search GitHub issues in repository"
            },
            "content": [
              {
