{
  "name": "jev-mcp-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "jev-mcp-router": "dist/cli.js" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --project tsconfig.check.json",
    "test": "node --import tsx --test test/router.test.ts test/stdio.test.ts test/metrics.test.ts",
    "start": "node dist/cli.js",
    "demo": "node --import tsx scripts/demo.ts",
    "compare": "node --import tsx scripts/compare.ts",
    "bench": "node --import tsx scripts/bench.ts",
    "audit": "node --import tsx scripts/audit.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@typesafe-ai/sdk": "0.6.0",
    "ajv": "8.17.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "js-tiktoken": "1.0.21"
  }
}
